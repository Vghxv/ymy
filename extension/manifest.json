{
  "manifest_version": 3,
  "name": "ymy",
  "version": "1.0.1",
  "description": "Download YouTube Music tracks as MP3 from the toolbar popup.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["nativeMessaging", "storage", "alarms", "notifications"],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Open a track on YouTube Music to download",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/off16.png",
      "32": "icons/off32.png",
      "48": "icons/off48.png",
      "128": "icons/off128.png"
    }
  },
  "icons": {
    "16": "icons/on16.png",
    "32": "icons/on32.png",
    "48": "icons/on48.png",
    "128": "icons/on128.png"
  }
}
